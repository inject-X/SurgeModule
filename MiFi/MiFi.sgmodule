#!name=随身WiFi面板
#!desc=连接随身 Wi-Fi 时展示蜂窝频段、信号质量、流量电量、当前卡槽与热点信息，进入页面自动刷新，同时适配 iOS 桌面小组件。
#!category=Panel
#!arguments=SSID:Wi-Fi,HOST:192.168.1.1,SHOW_PWD:1,USER:admin,ADMIN_PWD:admin
#!arguments-desc=SSID: 随身 Wi-Fi 名称（填 * 则仅按网关识别，iOS 未授予定位权限也可正常使用）\nHOST: 随身 Wi-Fi 后台地址（默认 192.168.1.1）\nSHOW_PWD: 是否显示热点密码（1=显示，0=隐藏，放桌面小组件可按需设为 0）\nUSER: 后台账号（默认 admin，仅接口需鉴权时自动使用）\nADMIN_PWD: 后台密码（默认 admin）

[Panel]
MiFi = script-name=MiFi,title=随身 Wi-Fi,content=正在读取设备状态…,update-interval=1

[Script]
MiFi = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/inject-X/SurgeModule/main/MiFi/MiFi.js,argument=ssid={{{SSID}}}&host={{{HOST}}}&pwd={{{SHOW_PWD}}}&user={{{USER}}}&admin_pwd={{{ADMIN_PWD}}}
