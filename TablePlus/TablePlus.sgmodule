[Script]
Aclove = type=http-request,pattern=^https://tableplus\.com/(v1/licenses/register|v1/licenses/devices|v1/apps/osx/tableplus|osx/version\.xml)(\?.*)?$,script-path=https://raw.githubusercontent.com/inject-X/SurgeModule/main/TablePlus/TablePlus.js,timeout=0,script-update-interval=86400,requires-body=1,max-size=0
[MITM]
hostname = %APPEND% tableplus.com
